<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Jarvis" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/jarvis_cyan</item>
        <item name="colorOnPrimary">@color/jarvis_surface</item>
        <item name="colorPrimaryContainer">@color/jarvis_cyan_container</item>
        <item name="colorOnPrimaryContainer">@color/jarvis_text</item>
        <item name="colorSecondary">@color/jarvis_amber</item>
        <item name="colorOnSecondary">@color/jarvis_surface</item>
        <item name="colorSecondaryContainer">@color/jarvis_surface_2</item>
        <item name="colorOnSecondaryContainer">@color/jarvis_text</item>
        <item name="colorTertiary">@color/jarvis_green</item>
        <item name="colorOnTertiary">@color/jarvis_surface</item>
        <item name="colorSurface">@color/jarvis_surface</item>
        <item name="colorOnSurface">@color/jarvis_text</item>
        <item name="colorSurfaceVariant">@color/jarvis_surface_2</item>
        <item name="colorOnSurfaceVariant">@color/jarvis_dim</item>
        <item name="colorOutline">@color/jarvis_card_stroke</item>
        <item name="colorError">@color/jarvis_red</item>
        <item name="colorOnError">@color/jarvis_surface</item>
        <item name="android:colorBackground">@color/jarvis_bg</item>
        <item name="android:windowBackground">@color/jarvis_bg</item>
        <item name="android:statusBarColor">@color/jarvis_bg</item>
        <item name="android:navigationBarColor">@color/jarvis_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:textColorPrimary">@color/jarvis_text</item>
        <item name="android:textColorSecondary">@color/jarvis_dim</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="materialButtonStyle">@style/Widget.Material3.Button.TextButton</item>
    </style>

    <style name="Theme.Jarvis.Settings" parent="Theme.Jarvis">
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
</resources>
