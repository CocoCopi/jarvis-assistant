JARVIS_PROVIDER=anthropic
JARVIS_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=

# NVIDIA NIM (OpenAI-compatible; keys from https://build.nvidia.com)
# JARVIS_PROVIDER=nvidia
# JARVIS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# NVIDIA_API_KEY=
# NGC_API_KEY=
# Self-hosted NIM:
# JARVIS_BASE_URL=http://localhost:8000/v1

# Alternatives:
# JARVIS_PROVIDER=openai
# JARVIS_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# JARVIS_BASE_URL=https://api.openai.com/v1
#
# JARVIS_PROVIDER=ollama
# JARVIS_MODEL=llama3.1
# JARVIS_BASE_URL=http://localhost:11434

JARVIS_STT=auto
JARVIS_TTS=auto
JARVIS_WHISPER_MODEL=base
JARVIS_LANGUAGE=en
JARVIS_VOICE=en-GB-RyanNeural
# JARVIS_INPUT_DEVICE=0
# JARVIS_WAKE_WORD=jarvis
# JARVIS_PIPER_MODEL=/path/to/en_GB-alan-medium.onnx

# Autonomy and skills
# JARVIS_MAX_STEPS=0
# JARVIS_UNSAFE=1
# JARVIS_SKILLS_DIR=~/.jarvis/skills
